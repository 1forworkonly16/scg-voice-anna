// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`toElevenLabsTool > snapshot of all tool definitions 1`] = `
[
  {
    "api_schema": {
      "content_type": "application/json",
      "method": "POST",
      "request_body_schema": {
        "description": "Request body of lookup_building.",
        "properties": {
          "address": {
            "description": "The address exactly as the caller said it, e.g. 'Илукстес 16' or 'Tirzes iela 3 k-2'.",
            "type": "string",
          },
          "conversation_id": {
            "description": "Conversation id. Filled automatically by the platform; never ask the caller.",
            "dynamic_variable": "system__conversation_id",
            "type": "string",
          },
          "language": {
            "description": "Language the caller is speaking right now: ru, lv or en.",
            "enum": [
              "ru",
              "lv",
              "en",
            ],
            "type": "string",
          },
        },
        "required": [
          "conversation_id",
          "language",
          "address",
        ],
        "type": "object",
      },
      "request_headers": {
        "x-scg-key": {
          "secret_id": "{secret_id}",
        },
      },
      "url": "{base_url}/tools/lookup_building",
    },
    "description": "Find the caller's building in the SCG address list from the address as spoken, for an inspection or a price. Not for residents asking about works at their building: use find_works_schedule. Returns status found/confirm/need_house/not_found and only sourced facts (unsourced ones are null). Read say_ru / say_lv aloud.",
    "name": "lookup_building",
    "response_timeout_secs": 8,
  },
  {
    "api_schema": {
      "content_type": "application/json",
      "method": "POST",
      "request_body_schema": {
        "description": "Request body of quote_range.",
        "properties": {
          "apartments": {
            "description": "Total number of apartments in the building, as the caller said it or as lookup_building returned it. Never guess.",
            "type": "integer",
          },
          "conversation_id": {
            "description": "Conversation id. Filled automatically by the platform; never ask the caller.",
            "dynamic_variable": "system__conversation_id",
            "type": "string",
          },
          "floors": {
            "description": "Number of floors above ground, e.g. 9.",
            "type": "integer",
          },
          "horizontals": {
            "description": "Include basement horizontal pipes (default true).",
            "type": "boolean",
          },
          "language": {
            "description": "Language the caller is speaking right now: ru, lv or en.",
            "enum": [
              "ru",
              "lv",
              "en",
            ],
            "type": "string",
          },
          "options": {
            "description": "Optional extras: opt_sound_fire_wrap, opt_new_towel_rail.",
            "items": {
              "enum": [
                "opt_sound_fire_wrap",
                "opt_new_towel_rail",
              ],
              "type": "string",
            },
            "type": "array",
          },
          "pump_station": {
            "description": "Include a booster pump station (default false).",
            "type": "boolean",
          },
          "scope": {
            "description": "Work scope. Default risers_complete (water + sewer risers). heating_risers is a separate scope.",
            "enum": [
              "risers_complete",
              "risers_water_only",
              "risers_sewer_only",
              "risers_kitchen_only",
              "heating_risers",
            ],
            "type": "string",
          },
          "sewer_outlet": {
            "description": "Include sewer outlet replacement (default false).",
            "type": "boolean",
          },
          "stairwells": {
            "description": "Number of stairwells (entrances), e.g. 4.",
            "type": "integer",
          },
        },
        "required": [
          "conversation_id",
          "language",
          "floors",
          "stairwells",
          "apartments",
        ],
        "type": "object",
      },
      "request_headers": {
        "x-scg-key": {
          "secret_id": "{secret_id}",
        },
      },
      "url": "{base_url}/tools/quote_range",
    },
    "description": "Compute the indicative price range for a building from floors, stairwells and apartments. Pass apartments only if the caller said the number or lookup_building returned it (not null); otherwise ask the caller first. Never calculate prices yourself; read say_ru / say_lv aloud.",
    "name": "quote_range",
    "response_timeout_secs": 8,
  },
  {
