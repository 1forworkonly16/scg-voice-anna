{
  "name": "scg-voice-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Demo C for Smart Comfort Group: voice assistant Anna. Pure core library and tool contract for the Cloudflare Worker.",
  "type": "module",
  "scripts": {
    "test": "node scripts/sync-data.mjs --check && vitest run",
    "typecheck": "tsc --noEmit",
