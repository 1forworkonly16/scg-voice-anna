    "lint:copy": "node scripts/copy-lint.mjs",
    "scan:secrets": "node scripts/secret-scan.mjs"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261002.1",
    "@types/node": "24.19.1",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "wrangler": "4.147.0"
  }
}
