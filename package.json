{
  "name": "scg-voice-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Demo C for Smart Comfort Group: voice assistant Anna. Pure core library and tool contract for the Cloudflare Worker.",
  "type": "module",
  "scripts": {
    "test": "node scripts/sync-data.mjs --check && vitest run && vitest run --config tests/worker/vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "gen:parity": "python scripts/gen-parity.py",
    "sync:data": "node scripts/sync-data.mjs",
    "lint:copy": "node scripts/copy-lint.mjs",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "test:worker": "vitest run --config tests/worker/vitest.config.ts",
    "dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry",
    "secrets:set": "node scripts/secrets.mjs",
    "integration": "node scripts/integration.ts",
    "el:tools": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/el/run.ps1 scripts/gen-tools.ts",
    "el:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/el/run.ps1 scripts/build-agent.ts",
    "el:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/el/run.ps1 scripts/check-agent.ts",
    "el:tests": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/el/run.ps1 scripts/el/tests.ts",
    "link:unlock": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/el/run.ps1 scripts/link.ts unlock",
    "link:lock": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/el/run.ps1 scripts/link.ts lock",
    "link:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/el/run.ps1 scripts/link.ts status"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261002.1",
    "@types/node": "24.19.1",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "wrangler": "4.147.0"
  }
}
